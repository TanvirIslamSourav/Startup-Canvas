# ==========================================================
# Startup Canvas — Environment variables (example)
# Copy this file to `.env` and adjust values.
# ==========================================================

# ----------------------------------------
# Backend (FastAPI)
# ----------------------------------------
ENVIRONMENT=development
LOG_LEVEL=info
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ----------------------------------------
# Database (PostgreSQL)
# ----------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=startup
POSTGRES_PASSWORD=startup
POSTGRES_DB=startup_canvas
DATABASE_URL=postgresql+psycopg://startup:startup@localhost:5432/startup_canvas

# ----------------------------------------
# Frontend (Vite)
# ----------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=Startup Canvas
